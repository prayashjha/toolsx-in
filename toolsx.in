<div class="tsx-v5-arw-root" id="tsxv5-arw-root">
<style>
  .tsx-v5-arw-root {
    --bg: #ffffff;
    --panel: #f8f9fa;
    --panel2: #e9ecef;
    --line: #dee2e6;
    --text: #1a1a1a;
    --muted: #495057;
    --pink: #d63384;
    --cyan: #0d6efd;
    --gold: #ffc107;
    --mono: 'JetBrains Mono', monospace;
    --display: 'Space Grotesk', sans-serif;
    --body: 'Inter', sans-serif;
    
    background: var(--bg);
    color: var(--text);
    font-family: var(--body);
    max-width: 1040px;
    margin: 0 auto;
    padding: 56px 20px 64px;
    border-radius: 20px;
    box-shadow: 0 0 0 1px var(--line);
  }
  .tsx-v5-arw-root * { box-sizing: border-box; }
  .tsx-v5-arw-root button { font-family: inherit; }

  /* Dark Mode Overrides */
  body.dark-mode .tsx-v5-arw-root,
  html[data-theme="dark"] .tsx-v5-arw-root,
  [data-theme="dark"] .tsx-v5-arw-root,
  body.night-mode .tsx-v5-arw-root,
  .dark-mode .tsx-v5-arw-root {
    --bg: #0B0E14;
    --panel: #131826;
    --panel2: #0f1420;
    --line: #1f2637;
    --text: #E8ECF1;
    --muted: #8791a3;
    --pink: #F472B6;
    --cyan: #5EEAD4;
    --gold: #FBBF24;
  }

  .tsx-v5-arw-notice {
    background: var(--panel2);
    border-left: 3px solid var(--cyan);
    padding: 10px 14px;
    border-radius: 6px;
    font-size: 12.5px;
    color: var(--muted);
    margin-bottom: 20px;
    line-height: 1.5;
  }

  .tsx-v5-arw-eyebrow {
    font-family: var(--mono);
    font-size: 11.5px;
    letter-spacing: .1em;
    color: var(--cyan);
    text-transform: uppercase;
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
  }
  .tsx-v5-arw-eyebrow .rec {
    width: 8px; height: 8px; border-radius: 50%; background: var(--pink);
    box-shadow: 0 0 8px var(--pink);
    animation: tsx-arw-rec 1.4s infinite;
  }
  @keyframes tsx-arw-rec { 0%, 100% { opacity: 1 } 50% { opacity: .3 } }

  .tsx-v5-arw-h1 {
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(28px, 4.6vw, 46px);
    line-height: 1.08;
    margin: 0 0 12px;
    letter-spacing: -0.01em;
  }
  .tsx-v5-arw-h1 span {
    background: linear-gradient(100deg, var(--pink), var(--cyan));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .tsx-v5-arw-sub {
    color: var(--muted);
    max-width: 560px;
    line-height: 1.6;
    margin: 0 0 18px;
    font-size: 15.5px;
  }

  .tsx-v5-arw-stat {
    font-family: var(--mono);
    font-size: 12.5px;
    color: var(--muted);
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .tsx-v5-arw-stat span { color: var(--cyan); font-weight: 700; font-size: 14px; }

  .tsx-v5-arw-submit-cta {
    display: flex;
    align-items: center;
    gap: 10px;
    background: linear-gradient(100deg, var(--cyan), var(--pink));
    color: #ffffff;
    border: none;
    font-weight: 700;
    font-size: 14px;
    padding: 12px 20px;
    border-radius: 10px;
    cursor: pointer;
    margin-bottom: 34px;
    transition: .2s;
  }
  .tsx-v5-arw-submit-cta:hover { filter: brightness(1.08); transform: translateY(-1px); }

  .tsx-v5-arw-submit-panel {
    display: none;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 20px;
    margin-bottom: 34px;
  }
  .tsx-v5-arw-submit-panel.open { display: block; }
  .tsx-v5-arw-submit-panel h2 { font-family: var(--display); font-size: 18px; margin-bottom: 6px; }
  .tsx-v5-arw-submit-panel .hint { color: var(--muted); font-size: 12.5px; margin-bottom: 16px; line-height: 1.6; }
  
  .tsx-v5-arw-field { margin-bottom: 12px; }
  .tsx-v5-arw-field label { display: block; font-size: 12.5px; color: var(--muted); margin-bottom: 6px; font-family: var(--mono); }
  .tsx-v5-arw-field input[type="text"], 
  .tsx-v5-arw-field input[type="url"], 
  .tsx-v5-arw-field select {
    width: 100%;
    background: var(--panel2);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 10px 12px;
    color: var(--text);
    font-size: 13.5px;
    outline: none;
    font-family: inherit;
  }
  .tsx-v5-arw-field input:focus, .tsx-v5-arw-field select:focus { border-color: var(--cyan); }
  
  .tsx-v5-arw-check {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 12px;
    color: var(--muted);
    margin: 14px 0;
    line-height: 1.5;
  }
  .tsx-v5-arw-check input { margin-top: 3px; }
  
  .tsx-v5-arw-submit-actions { display: flex; gap: 10px; margin-top: 6px; flex-wrap: wrap; }
  .tsx-v5-arw-btn-primary {
    background: linear-gradient(100deg, var(--cyan), var(--pink));
    color: #ffffff;
    border: none;
    font-weight: 700;
    font-size: 13px;
    padding: 10px 18px;
    border-radius: 8px;
    cursor: pointer;
  }
  .tsx-v5-arw-btn-secondary {
    background: transparent;
    border: 1px solid var(--line);
    color: var(--muted);
    font-size: 13px;
    padding: 10px 18px;
    border-radius: 8px;
    cursor: pointer;
  }
  .tsx-v5-arw-error { color: var(--pink); font-size: 12px; margin-top: 8px; display: none; }

  .tsx-v5-arw-leaderboard {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    padding-bottom: 6px;
    margin-bottom: 34px;
  }
  .tsx-v5-arw-lb-item {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    gap: 10px;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 10px 14px;
    font-family: var(--mono);
    font-size: 12.5px;
    color: var(--muted);
  }
  .tsx-v5-arw-lb-rank {
    width: 22px; height: 22px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-weight: 700; font-size: 11px; color: #ffffff;
  }
  .tsx-v5-arw-lb-item:nth-child(1) .tsx-v5-arw-lb-rank { background: var(--gold); color: #000; }
  .tsx-v5-arw-lb-item:nth-child(2) .tsx-v5-arw-lb-rank { background: #c7d0dd; color: #000; }
  .tsx-v5-arw-lb-item:nth-child(3) .tsx-v5-arw-lb-rank { background: #d7a17a; color: #000; }
  .tsx-v5-arw-lb-name { color: var(--text); font-family: var(--body); font-weight: 600; }

  .tsx-v5-arw-controls {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
    flex-wrap: wrap;
    gap: 12px;
  }
  .tsx-v5-arw-sort { display: flex; gap: 8px; flex-wrap: wrap; }
  .tsx-v5-arw-sort button {
    background: var(--panel);
    border: 1px solid var(--line);
    color: var(--muted);
    padding: 8px 14px;
    border-radius: 8px;
    font-size: 13px;
    cursor: pointer;
    transition: .2s;
  }
  .tsx-v5-arw-sort button.active {
    color: #ffffff;
    background: linear-gradient(100deg, var(--cyan), var(--pink));
    border-color: transparent;
    font-weight: 600;
  }
  .tsx-v5-arw-count { font-family: var(--mono); font-size: 12px; color: var(--muted); }

  .tsx-v5-arw-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
  }

  .tsx-v5-arw-empty {
    grid-column: 1 / -1;
    text-align: center;
    padding: 50px 20px;
    color: var(--muted);
    border: 1px dashed var(--line);
    border-radius: 14px;
    font-size: 14px;
    line-height: 1.7;
  }

  .tsx-v5-arw-card {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 14px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform .3s ease, border-color .3s ease;
  }
  .tsx-v5-arw-card:hover { transform: translateY(-3px); border-color: var(--cyan); }

  .tsx-v5-arw-thumb {
    position: relative;
    aspect-ratio: 16/9;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: var(--panel2);
    cursor: pointer;
  }
  .tsx-v5-arw-thumb img { width: 100%; height: 100%; object-fit: cover; opacity: .85; }
  .tsx-v5-arw-thumb iframe { width: 100%; height: 100%; border: 0; }
  .tsx-v5-arw-play {
    position: absolute;
    width: 46px; height: 46px; border-radius: 50%;
    background: rgba(0,0,0,0.4);
    backdrop-filter: blur(2px);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-size: 16px;
    z-index: 2;
    border: 1px solid rgba(255,255,255,0.3);
  }
  .tsx-v5-arw-src-badge {
    position: absolute;
    top: 8px; left: 8px;
    font-family: var(--mono);
    font-size: 9.5px;
    background: rgba(0,0,0,0.6);
    padding: 2px 7px;
    border-radius: 5px;
    z-index: 2;
    color: var(--cyan);
    letter-spacing: .05em;
  }

  .tsx-v5-arw-body { padding: 16px; display: flex; flex-direction: column; gap: 10px; flex: 1; }
  .tsx-v5-arw-tag { font-family: var(--mono); font-size: 10.5px; color: var(--pink); letter-spacing: .05em; }
  .tsx-v5-arw-card h3 { font-family: var(--display); font-size: 16.5px; margin: 0; font-weight: 600; word-break: break-word; }
  .tsx-v5-arw-creator { color: var(--muted); font-size: 12.5px; }

  .tsx-v5-arw-actions { display: flex; align-items: center; gap: 10px; margin-top: 4px; flex-wrap: wrap; }
  .tsx-v5-arw-act {
    display: flex; align-items: center; gap: 6px;
    background: transparent; border: none; color: var(--muted);
    cursor: pointer; font-size: 13px; padding: 4px 6px; border-radius: 6px; transition: .2s;
  }
  .tsx-v5-arw-act:hover { color: var(--text); background: var(--panel2); }
  .tsx-v5-arw-act.voted { color: var(--cyan); }
  .tsx-v5-arw-act.liked { color: var(--pink); }
  .tsx-v5-arw-act .n { font-family: var(--mono); font-size: 12.5px; }

  .tsx-v5-arw-comments { margin-top: 6px; border-top: 1px dashed var(--line); padding-top: 10px; }
  .tsx-v5-arw-clist { display: flex; flex-direction: column; gap: 6px; max-height: 90px; overflow-y: auto; margin-bottom: 8px; }
  .tsx-v5-arw-clist div { font-size: 12.5px; color: var(--muted); }
  .tsx-v5-arw-clist b { color: var(--text); font-weight: 600; }
  .tsx-v5-arw-cform { display: flex; gap: 6px; }
  .tsx-v5-arw-cform input {
    flex: 1;
    background: var(--panel2);
    border: 1px solid var(--line);
    border-radius: 7px;
    padding: 7px 10px;
    color: var(--text);
    font-size: 12.5px;
    outline: none;
  }
  .tsx-v5-arw-cform input:focus { border-color: var(--cyan); }
  .tsx-v5-arw-cform button {
    background: linear-gradient(100deg, var(--cyan), var(--pink));
    border: none;
    color: #ffffff;
    font-weight: 700;
    font-size: 12px;
    padding: 0 12px;
    border-radius: 7px;
    cursor: pointer;
  }

  /* Guide Section */
  .tsx-v5-arw-guide {
    margin-top: 40px;
    padding: 24px;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 14px;
  }
  .tsx-v5-arw-guide h2 {
    font-family: var(--display);
    font-size: 22px;
    font-weight: 700;
    margin-bottom: 16px;
    color: var(--text);
  }
  .tsx-v5-arw-guide h3 {
    font-family: var(--display);
    font-size: 16px;
    font-weight: 700;
    color: var(--cyan);
    margin: 18px 0 8px;
  }
  .tsx-v5-arw-guide p, .tsx-v5-arw-guide li {
    font-size: 14px;
    line-height: 1.7;
    color: var(--muted);
    margin-bottom: 8px;
  }
  .tsx-v5-arw-guide ul { padding-left: 20px; }
  .tsx-v5-arw-guide strong { color: var(--text); }

  .tsx-v5-arw-related {
    margin-top: 40px;
    padding: 24px;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 14px;
  }
  .tsx-v5-arw-related h2 {
    font-family: var(--display);
    font-size: 20px;
    margin-bottom: 16px;
    color: var(--text);
  }
  .tsx-v5-arw-related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 14px;
  }
  .tsx-v5-arw-related-link {
    background: var(--panel2);
    border: 1px solid var(--line);
    padding: 16px;
    text-decoration: none;
    border-radius: 10px;
    transition: .2s;
  }
  .tsx-v5-arw-related-link:hover { border-color: var(--cyan); transform: translateY(-2px); }
  .tsx-v5-arw-related-link strong { color: var(--cyan); display: block; font-size: 15px; margin-bottom: 4px; }
  .tsx-v5-arw-related-link span { color: var(--muted); font-size: 12.5px; }

  .tsx-v5-arw-footnote {
    margin-top: 34px;
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--muted);
    border-top: 1px dashed var(--line);
    padding-top: 16px;
    line-height: 1.6;
  }

  @media (max-width: 480px) {
    .tsx-v5-arw-root { padding: 40px 14px 48px; border-radius: 16px; }
    .tsx-v5-arw-controls { flex-direction: column; align-items: flex-start; }
  }
</style>

<!-- SEO Schema -->
