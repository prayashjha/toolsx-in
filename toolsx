  var ids=["tsxv5-url","tsxv5-title","tsxv5-desc","tsxv5-type","tsxv5-keywords","tsxv5-handle","tsxv5-image","tsxv5-lang","tsxv5-author","tsxv5-v-google","tsxv5-v-bing","tsxv5-v-pinterest","tsxv5-v-yandex","tsxv5-cc-title","tsxv5-cc-desc","tsxv5-bar-title","tsxv5-bar-desc","tsxv5-schema-badge","tsxv5-pv-title","tsxv5-pv-desc","tsxv5-pv-url","tsxv5-pv-bc","tsxv5-pv-social-title","tsxv5-pv-social-desc","tsxv5-pv-social-meta","tsxv5-pv-badges","tsxv5-code","tsxv5-copy","tsxv5-copy-quick","tsxv5-reset","tsxv5-download-html","tsxv5-download-json","tsxv5-toast","tsxv5-score-board","tsxv5-score-circle","tsxv5-score-num","tsxv5-score-text","tsxv5-score-badges"];
  var e={};
  ids.forEach(function(i){e[i]=document.getElementById(i)});
  var inputs=[e["tsxv5-url"],e["tsxv5-title"],e["tsxv5-desc"],e["tsxv5-type"],e["tsxv5-keywords"],e["tsxv5-handle"],e["tsxv5-image"],e["tsxv5-lang"],e["tsxv5-author"],e["tsxv5-v-google"],e["tsxv5-v-bing"],e["tsxv5-v-pinterest"],e["tsxv5-v-yandex"]];

  function esc(s){if(s==null)return"";return String(s).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;").replace(/'/g,"&#39;")}

  var OG={website:"website",blog:"website",article:"article",product:"product",portfolio:"website",education:"website",entertainment:"website",social:"website",forum:"website",software:"website",mobileapp:"website",game:"website",music:"music.song",video:"video.other",event:"website",organization:"website",government:"website",health:"website",finance:"website",realestate:"website",travel:"website",food:"restaurant",fashion:"product",sports:"website",technology:"website",science:"article",religion:"website",recipe:"recipe",job:"jobPosting",adult:"website"};
  var SC={website:"WebSite",blog:"Blog",article:"NewsArticle",product:"Product",portfolio:"CreativeWork",education:"Course",entertainment:"CreativeWork",social:"WebSite",forum:"DiscussionForumPosting",software:"SoftwareApplication",mobileapp:"MobileApplication",game:"VideoGame",music:"MusicRecording",video:"VideoObject",event:"Event",organization:"Organization",government:"GovernmentOrganization",health:"MedicalWebPage",finance:"FinancialProduct",realestate:"RealEstateListing",travel:"TouristAttraction",food:"Restaurant",fashion:"Product",sports:"SportsOrganization",technology:"WebSite",science:"ScholarlyArticle",religion:"WebSite",recipe:"Recipe",job:"JobPosting",adult:"WebPage"};

  function cleanUrl(raw){
    if(!raw)return"https://yourdomain.com";
    var c=String(raw).trim().toLowerCase();
    c=c.replace(/^https?:\/\//i,"").replace(/^www\./,"");
    c=c.replace(/[<>\"'\s]/g,"");
    if(!c)return"https://yourdomain.com";
    return"https://"+c;
  }
  function cleanImg(raw){
    if(!raw)return"https://yourdomain.com/og-image.jpg";
    var c=String(raw).trim();
    if(!/^https?:\/\//i.test(c))c="https://"+c.replace(/^\/+/,"");
    return c.replace(/[<>\"'\s]/g,"");
  }
  function handle(raw){
    var h=String(raw||"").trim().replace(/^@+|[^a-zA-Z0-9_]/g,"");
    return h?"@"+h:"@yourbrand";
  }
  
  function sanitizeFilename(name) {
    return String(name || 'toolsx-meta-tags').replace(/[^a-zA-Z0-9._-]/g, '').substring(0, 100) || 'toolsx-meta-tags';
  }

  function setBar(barEl,ccEl,len,max){
    if(!barEl || !ccEl) return;
    var pct=Math.min(100,(len/max)*100);
    barEl.style.width=pct+"%";
    ccEl.textContent=len+" / "+max;
    barEl.className="aml-bar-fill";
    ccEl.className="aml-cc";
    if(len>max){barEl.classList.add("err");ccEl.classList.add("err")}
    else if(len>max*0.85){barEl.classList.add("warn");ccEl.classList.add("warn")}
  }

  var ttTimer;
  function toast(msg,type){
    type=type||"ok";
    if(!e["tsxv5-toast"]) return;
    e["tsxv5-toast"].textContent=msg;
    e["tsxv5-toast"].className="show "+type;
    clearTimeout(ttTimer);
    ttTimer=setTimeout(function(){e["tsxv5-toast"].className="tsxv5-toast"},2600);
  }

  function calcScore(){
    var score=0;
    var badges=[];
    var url=cleanUrl(e["tsxv5-url"].value);
    var title=String(e["tsxv5-title"].value||"").trim();
    var desc=String(e["tsxv5-desc"].value||"").trim();
    var type=e["tsxv5-type"].value||"website";
    var keywords=String(e["tsxv5-keywords"].value||"").trim();
    var hnd=String(e["tsxv5-handle"].value||"").trim();
    var img=String(e["tsxv5-image"].value||"").trim();
    var lang=String(e["tsxv5-lang"].value||"").trim();
    var author=String(e["tsxv5-author"].value||"").trim();
    
    if(url && url!=="https://yourdomain.com"){score+=10; badges.push({t:"Domain Set", c:"ok"})}
    if(title.length>=30 && title.length<=60){score+=20; badges.push({t:"Title Perfect", c:"ok"})}
    else if(title.length>0){score+=10; badges.push({t:"Title Weak", c:"warn"})}
    if(desc.length>=120 && desc.length<=160){score+=20; badges.push({t:"Desc Perfect", c:"ok"})}
    else if(desc.length>0){score+=10; badges.push({t:"Desc Weak", c:"warn"})}
    if(type!=="website"){score+=10; badges.push({t:"Schema: "+SC[type], c:"ok"})}
    if(img && img!=="https://yourdomain.com/og-image.jpg"){score+=15; badges.push({t:"OG Image", c:"ok"})}
    if(lang){score+=10; badges.push({t:"Language: "+lang, c:"ok"})}
    if(author){score+=10; badges.push({t:"Author Set", c:"ok"})}
    if(keywords.split(",").length>=3){score+=5; badges.push({t:"Keywords", c:"ok"})}
    
    if(e["tsxv5-score-num"]) e["tsxv5-score-num"].textContent=score;
    if(e["tsxv5-score-circle"]) e["tsxv5-score-circle"].style.setProperty("--score-pct", score+"%");
    
    var txt="Fill in the details to improve your score.";
    if(score>=80) txt="Excellent! Your meta tags are highly optimized.";
    else if(score>=50) txt="Good start. Add more details to reach 100%.";
    if(e["tsxv5-score-text"]) e["tsxv5-score-text"].textContent=txt;
    
    if(e["tsxv5-score-badges"]) {
      e["tsxv5-score-badges"].innerHTML="";
      badges.forEach(function(b){
        var s=document.createElement("span");
        s.className="aml-sb "+b.c;
        s.textContent=b.t;
        e["tsxv5-score-badges"].appendChild(s);
      });
    }
  }

  function updatePreview(){
    var url=cleanUrl(e["tsxv5-url"].value);
    var title=esc(String(e["tsxv5-title"].value||"").trim()) || "Website Title";
    var desc=esc(String(e["tsxv5-desc"].value||"").trim()) || "Your website description will appear here...";
    var type=e["tsxv5-type"].value||"website";
    var hnd=handle(e["tsxv5-handle"].value);
    
    var dispUrl=url.replace(/^https?:\/\//,"").replace(/^www\./,"");
    if(e["tsxv5-pv-url"]) e["tsxv5-pv-url"].textContent=dispUrl;
    if(e["tsxv5-pv-title"]) e["tsxv5-pv-title"].textContent=title;
    if(e["tsxv5-pv-desc"]) e["tsxv5-pv-desc"].textContent=desc;
    if(e["tsxv5-pv-bc"]) e["tsxv5-pv-bc"].innerHTML='Home › <span>'+esc(dispUrl.split("/")[1] || "Page")+'</span>';
    
    if(e["tsxv5-pv-social-title"]) e["tsxv5-pv-social-title"].textContent=title;
    if(e["tsxv5-pv-social-desc"]) e["tsxv5-pv-social-desc"].textContent=desc;
    if(e["tsxv5-pv-social-meta"]) e["tsxv5-pv-social-meta"].textContent=dispUrl + " | " + hnd;
    
    if(e["tsxv5-pv-badges"]) {
      e["tsxv5-pv-badges"].innerHTML='<span class="aml-sp-b">og:type = '+OG[type]+'</span><span class="aml-sp-b">schema = '+SC[type]+'</span><span class="aml-sp-b">llm-ready</span>';
    }
    if(e["tsxv5-schema-badge"]) e["tsxv5-schema-badge"].textContent="Schema: "+SC[type];
  }

  function generateCode(){
    // Raw unescaped variables for JSON-LD
    var rawTitle = String(e["tsxv5-title"].value||"").trim();
    var rawDesc = String(e["tsxv5-desc"].value||"").trim();
    var rawKeywords = String(e["tsxv5-keywords"].value||"").trim();
    var rawLang = String(e["tsxv5-lang"].value||"en-US").trim();
    var rawAuthor = String(e["tsxv5-author"].value||"").trim();
    
    // HTML-escaped variables for meta tags
    var url=cleanUrl(e["tsxv5-url"].value);
    var title=esc(rawTitle);
    var desc=esc(rawDesc);
    var type=e["tsxv5-type"].value||"website";
    var keywords=esc(rawKeywords);
    var hnd=handle(e["tsxv5-handle"].value);
    var img=cleanImg(e["tsxv5-image"].value);
    var lang=esc(rawLang);
    var author=esc(rawAuthor);
    var vG=esc(String(e["tsxv5-v-google"].value||"").trim());
    var vB=esc(String(e["tsxv5-v-bing"].value||"").trim());
    var vP=esc(String(e["tsxv5-v-pinterest"].value||"").trim());
    var vY=esc(String(e["tsxv5-v-yandex"].value||"").trim());
    
    // Open Graph locale requires underscore format (e.g., en_US)
    var ogLocale = rawLang.replace('-', '_');
    
    var today=new Date().toISOString();
    
    var code='<!-- Primary Meta Tags -->\n';
    code+='<title>'+title+'</title>\n';
    code+='<meta name="title" content="'+title+'">\n';
    code+='<meta name="description" content="'+desc+'">\n';
    if(keywords) code+='<meta name="keywords" content="'+keywords+'">\n';
    if(author) code+='<meta name="author" content="'+author+'">\n';
    code+='<meta name="language" content="'+lang+'">\n';
    code+='<meta name="robots" content="index, follow, max-image-preview:large">\n';
    code+='<meta http-equiv="Content-Type" content="text/html; charset=UTF-8">\n';
    code+='<link rel="canonical" href="'+url+'">\n\n';
    
    code+='<!-- Open Graph / Facebook -->\n';
    code+='<meta property="og:type" content="'+OG[type]+'">\n';
    code+='<meta property="og:url" content="'+url+'">\n';
    code+='<meta property="og:title" content="'+title+'">\n';
    code+='<meta property="og:description" content="'+desc+'">\n';
    code+='<meta property="og:image" content="'+img+'">\n';
    code+='<meta property="og:image:alt" content="'+title+'">\n';
    code+='<meta property="og:locale" content="'+ogLocale+'">\n';
    if(author) code+='<meta property="og:site_name" content="'+author+'">\n\n';
    
    code+='<!-- Twitter -->\n';
    code+='<meta property="twitter:card" content="summary_large_image">\n';
    code+='<meta property="twitter:url" content="'+url+'">\n';
    code+='<meta property="twitter:title" content="'+title+'">\n';
    code+='<meta property="twitter:description" content="'+desc+'">\n';
    code+='<meta property="twitter:image" content="'+img+'">\n';
    code+='<meta property="twitter:image:alt" content="'+title+'">\n';
    if(hnd!=="@yourbrand") code+='<meta property="twitter:site" content="'+hnd+'">\n';
    if(hnd!=="@yourbrand") code+='<meta property="twitter:creator" content="'+hnd+'">\n\n';
    
    code+='<!-- JSON-LD Schema -->\n';
    var schema={
      "@context": "https://schema.org",
      "@type": SC[type],
      "name": rawTitle || "Website Title",
      "description": rawDesc || "Website description",
      "url": url,
      "image": img,
      "inLanguage": rawLang,
      "datePublished": today,
      "dateModified": today
    };
    if(rawAuthor) schema.author = {"@type": "Person", "name": rawAuthor};
    if(rawAuthor) schema.publisher = {"@type": "Organization", "name": rawAuthor, "logo": {"@type": "ImageObject", "url": img}};
    code+='<script type="application/ld+json">\n'+JSON.stringify(schema, null, 2)+'\n<\/script>\n\n';
    
    if(vG) code+='<!-- Verifications -->\n<meta name="google-site-verification" content="'+vG.replace(/[^a-zA-Z0-9_-]/g,'')+'">\n';
    if(vB) code+='<meta name="msvalidate.01" content="'+vB.replace(/[^a-zA-Z0-9_-]/g,'')+'">\n';
    if(vP) code+='<meta name="p:domain_verify" content="'+vP.replace(/[^a-zA-Z0-9_-]/g,'')+'">\n';
    if(vY) code+='<meta name="yandex-verification" content="'+vY.replace(/[^a-zA-Z0-9_-]/g,'')+'">\n';
    
    if(e["tsxv5-code"]) e["tsxv5-code"].textContent=code;
    return code;
  }

  function updateAll(){
    var tLen = (e["tsxv5-title"].value||"").length;
    var dLen = (e["tsxv5-desc"].value||"").length;
    setBar(e["tsxv5-bar-title"], e["tsxv5-cc-title"], tLen, 60);
    setBar(e["tsxv5-bar-desc"], e["tsxv5-cc-desc"], dLen, 160);
    updatePreview();
    generateCode();
    calcScore();
  }

  inputs.forEach(function(inp){
    if(inp) inp.addEventListener("input", updateAll);
  });

  if(e["tsxv5-copy"]) e["tsxv5-copy"].addEventListener("click", function(){
    if(!e["tsxv5-code"]) return;
    navigator.clipboard.writeText(e["tsxv5-code"].textContent).then(function(){
      toast("Meta tags copied to clipboard!", "ok");
    }).catch(function(){
      toast("Failed to copy. Please select and copy manually.", "err");
    });
  });

  if(e["tsxv5-copy-quick"]) e["tsxv5-copy-quick"].addEventListener("click", function(){
    if(!e["tsxv5-code"]) return;
    navigator.clipboard.writeText(e["tsxv5-code"].textContent).then(function(){
      toast("Meta tags copied!", "ok");
    }).catch(function(){
      toast("Failed to copy.", "err");
    });
  });

  if(e["tsxv5-reset"]) e["tsxv5-reset"].addEventListener("click", function(){
    inputs.forEach(function(inp){ if(inp) inp.value=""; });
    updateAll();
    toast("All fields reset.", "info");
  });

  function downloadFile(content, type) {
    var safeName = sanitizeFilename(e["tsxv5-title"].value);
    var ext = type === 'application/json' ? '.json' : '.html';
    var blob = new Blob([content], {type: type});
    var url = URL.createObjectURL(blob);
    var a = document.createElement('a');
    a.href = url;
    a.download = safeName + ext;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
    toast("File downloaded: " + safeName + ext, "ok");
  }

  if(e["tsxv5-download-html"]) e["tsxv5-download-html"].addEventListener("click", function(){
    if(!e["tsxv5-code"]) return;
    var htmlContent = '<!DOCTYPE html>\n<html>\n<head>\n' + e["tsxv5-code"].textContent + '\n</head>\n<body></body>\n</html>';
    downloadFile(htmlContent, 'text/html');
  });

  if(e["tsxv5-download-json"]) e["tsxv5-download-json"].addEventListener("click", function(){
    var url=cleanUrl(e["tsxv5-url"].value);
    var rawTitle = String(e["tsxv5-title"].value||"").trim();
    var rawDesc = String(e["tsxv5-desc"].value||"").trim();
    var type=e["tsxv5-type"].value||"website";
    var rawKeywords = String(e["tsxv5-keywords"].value||"").trim();
    var hnd=handle(e["tsxv5-handle"].value);
    var img=cleanImg(e["tsxv5-image"].value);
    var rawLang = String(e["tsxv5-lang"].value||"en-US").trim();
    var rawAuthor = String(e["tsxv5-author"].value||"").trim();
    
    var jsonData = {
      "primary": {"title": rawTitle, "description": rawDesc, "url": url, "keywords": rawKeywords, "language": rawLang, "author": rawAuthor},
      "og": {"type": OG[type], "image": img, "handle": hnd, "locale": rawLang.replace('-', '_')},
      "schema": {"type": SC[type]}
    };
    downloadFile(JSON.stringify(jsonData, null, 2), 'application/json');
  });

  updateAll();
})();
</script>
