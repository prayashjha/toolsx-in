<div id="tsxv5-ailab-toast">Ready</div>
<input type="file" id="tsxv5-ailab-fileInput" accept="image/*" hidden>

<script>
(function () {
    'use strict';

    const DEFAULTS = {
        brightness: 100, contrast: 100, saturation: 100, blur: 0,
        grayscale: 0, sepia: 0, invert: 0, hue: 0
    };
    const state = Object.assign({}, DEFAULTS);
    let sourceImage = null;
    let fileName = '';
    let fileSize = 0;
    let rotation = 0;
    let flipH = false;
    let flipV = false;
    let renderPending = false;
    let activePreset = 'Original';

    const $ = (id) => document.getElementById(id);
    const canvas = $('tsxv5-ailab-canvas');
    const ctx = canvas.getContext('2d');
    const stage = $('tsxv5-ailab-canvasStage');
    const dropContent = $('tsxv5-ailab-dropContent');
    const fileInput = $('tsxv5-ailab-fileInput');
    const toast = $('tsxv5-ailab-toast');

    const testCtx = document.createElement('canvas').getContext('2d');
    testCtx.filter = 'blur(1px)';
    const FILTER_OK = (testCtx.filter === 'blur(1px)');

    const SLIDERS = [
        { key: 'brightness', label: '☀️ Brightness', min: 0, max: 200, suffix: '%', step: 1 },
        { key: 'contrast',   label: '◐ Contrast',    min: 0, max: 200, suffix: '%', step: 1 },
        { key: 'saturation', label: ' Saturation', min: 0, max: 200, suffix: '%', step: 1 },
        { key: 'blur',       label: '💧 Blur',       min: 0, max: 20,  suffix: 'px', step: 0.5 },
        { key: 'grayscale',  label: '⬜ Grayscale',  min: 0, max: 100, suffix: '%', step: 1 },
        { key: 'sepia',      label: '🟤 Sepia',      min: 0, max: 100, suffix: '%', step: 1 },
        { key: 'invert',     label: '🔲 Invert',     min: 0, max: 100, suffix: '%', step: 1 },
        { key: 'hue',        label: ' Hue Rotate', min: 0, max: 360, suffix: '°', step: 1 }
    ];

    const PRESETS = [
        { name: 'Original', icon: '', values: {} },
        { name: 'Vivid',    icon: '🔥', values: { saturation: 165, contrast: 115 } },
        { name: 'B&W',      icon: '⬛', values: { grayscale: 100, contrast: 112 } },
        { name: 'Noir',     icon: '🎬', values: { grayscale: 100, contrast: 145, brightness: 88 } },
        { name: 'Vintage',  icon: '', values: { sepia: 45, contrast: 105, brightness: 108, saturation: 125 } },
        { name: 'Retro',    icon: '📼', values: { sepia: 60, hue: 350, brightness: 105, contrast: 95 } },
        { name: 'Warm',     icon: '🌅', values: { sepia: 28, saturation: 135, brightness: 106 } },
        { name: 'Cool',     icon: '❄️', values: { hue: 25, saturation: 112, brightness: 103, contrast: 105 } },
        { name: 'Drama',    icon: '⚡', values: { contrast: 150, brightness: 92, saturation: 118 } },
        { name: 'Fade',     icon: '️', values: { contrast: 82, brightness: 112, saturation: 78 } },
        { name: 'Dreamy',   icon: '💭', values: { blur: 1.5, brightness: 108, saturation: 118 } },
        { name: 'Pop',      icon: '🎪', values: { saturation: 180, contrast: 125, brightness: 105 } }
    ];

    const sliderRefs = {};
    const slidersBox = $('tsxv5-ailab-slidersBox');
    SLIDERS.forEach(function (def) {
        const row = document.createElement('div');
        row.className = 'ailab-slider-row';
        row.innerHTML =
            '<div class="ailab-slider-head">' +
                '<label>' + def.label + '</label>' +
                '<span class="ailab-slider-val">' + DEFAULTS[def.key] + def.suffix + '</span>' +
            '</div>' +
            '<input type="range" class="ailab-slider" min="' + def.min + '" max="' + def.max + '" step="' + def.step + '" value="' + DEFAULTS[def.key] + '">';
        slidersBox.appendChild(row);
        const input = row.querySelector('input');
        const valEl = row.querySelector('.ailab-slider-val');
        sliderRefs[def.key] = { input: input, valEl: valEl, suffix: def.suffix };
        input.addEventListener('input', function () {
            state[def.key] = parseFloat(input.value);
            valEl.textContent = input.value + def.suffix;
            setActivePreset(null);
            requestRender();
        });
    });

    const presetsGrid = $('tsxv5-ailab-presetsGrid');
    PRESETS.forEach(function (preset) {
        const card = document.createElement('div');
        card.className = 'ailab-preset-card' + (preset.name === 'Original' ? ' tsxv5-active' : '');
        card.setAttribute('data-name', preset.name);
        card.innerHTML =
            '<div class="ailab-preset-placeholder">' + preset.icon + '</div>' +
            '<div class="ailab-preset-name">' + preset.name + '</div>';
        card.addEventListener('click', function () { applyPreset(preset); });
        presetsGrid.appendChild(card);
    });

    function filterStringFromValues(v) {
        return 'brightness(' + v.brightness + '%) ' +
               'contrast(' + v.contrast + '%) ' +
               'saturate(' + v.saturation + '%) ' +
               'blur(' + v.blur + 'px) ' +
               'grayscale(' + v.grayscale + '%) ' +
               'sepia(' + v.sepia + '%) ' +
               'invert(' + v.invert + '%) ' +
               'hue-rotate(' + v.hue + 'deg)';
    }

    function buildFilter() { return filterStringFromValues(state); }

    function applyPreset(preset) {
        Object.assign(state, DEFAULTS, preset.values);
        SLIDERS.forEach(function (def) {
            const ref = sliderRefs[def.key];
            ref.input.value = state[def.key];
            ref.valEl.textContent = state[def.key] + def.suffix;
        });
        setActivePreset(preset.name);
        requestRender();
        showToast('✨ Preset applied: ' + preset.name);
    }

    function setActivePreset(name) {
        activePreset = name;
        const cards = presetsGrid.querySelectorAll('.ailab-preset-card');
        cards.forEach(function (c) {
            c.classList.toggle('tsxv5-active', c.getAttribute('data-name') === name);
        });
    }

    function requestRender() {
        if (renderPending) return;
        renderPending = true;
        requestAnimationFrame(function () {
            render(false);
            renderPending = false;
        });
    }

    function render(showOriginal) {
        if (!sourceImage) return;
        const w = sourceImage.width;
        const h = sourceImage.height;
        const swapped = (rotation % 180 !== 0);
        canvas.width = swapped ? h : w;
        canvas.height = swapped ? w : h;
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        ctx.save();
        if (!showOriginal && FILTER_OK) ctx.filter = buildFilter();
        ctx.translate(canvas.width / 2, canvas.height / 2);
        ctx.rotate(rotation * Math.PI / 180);
        ctx.scale(flipH ? -1 : 1, flipV ? -1 : 1);
        ctx.drawImage(sourceImage, -w / 2, -h / 2);
        ctx.restore();
    }

    function buildThumbnails() {
        if (!sourceImage) return;
        const cards = presetsGrid.querySelectorAll('.ailab-preset-card');
        cards.forEach(function (card, i) {
            const preset = PRESETS[i];
            const placeholder = card.querySelector('.ailab-preset-placeholder');
            let thumb = card.querySelector('canvas');
            if (!thumb) {
                thumb = document.createElement('canvas');
                placeholder.replaceWith(thumb);
            }
            const SIZE = 90;
            thumb.width = SIZE;
            thumb.height = SIZE;
            const tctx = thumb.getContext('2d');
            const scale = Math.max(SIZE / sourceImage.width, SIZE / sourceImage.height);
            const sw = SIZE / scale;
            const sh = SIZE / scale;
            const sx = (sourceImage.width - sw) / 2;
            const sy = (sourceImage.height - sh) / 2;
            tctx.save();
            if (FILTER_OK) {
                tctx.filter = filterStringFromValues(Object.assign({}, DEFAULTS, preset.values));
            }
            tctx.drawImage(sourceImage, sx, sy, sw, sh, 0, 0, SIZE, SIZE);
            tctx.restore();
        });
    }

    function openPicker() { fileInput.click(); }

    fileInput.addEventListener('change', function () {
        if (fileInput.files && fileInput.files[0]) loadFile(fileInput.files[0]);
        fileInput.value = '';
    });

    dropContent.addEventListener('click', openPicker);
    $('tsxv5-ailab-uploadBtn').addEventListener('click', openPicker);

    stage.addEventListener('dragover', function (e) {
        e.preventDefault();
        stage.classList.add('tsxv5-dragover');
    });
    stage.addEventListener('dragleave', function () {
        stage.classList.remove('tsxv5-dragover');
    });
    stage.addEventListener('drop', function (e) {
        e.preventDefault();
        stage.classList.remove('tsxv5-dragover');
        if (e.dataTransfer.files && e.dataTransfer.files[0]) loadFile(e.dataTransfer.files[0]);
    });

    function loadFile(file) {
        if (!file.type || file.type.indexOf('image/') !== 0) {
            showToast('⚠️ Please choose a valid image file', true);
            return;
        }
        const reader = new FileReader();
        reader.onload = function (e) {
            const img = new Image();
            img.onload = function () {
                const MAX = 2400;
                let src = img;
                if (img.width > MAX || img.height > MAX) {
                    const scale = Math.min(MAX / img.width, MAX / img.height);
                    const tc = document.createElement('canvas');
                    tc.width = Math.round(img.width * scale);
                    tc.height = Math.round(img.height * scale);
                    tc.getContext('2d').drawImage(img, 0, 0, tc.width, tc.height);
                    src = tc;
                }
                sourceImage = src;
                fileName = file.name;
                fileSize = file.size;
                resetAll(true);
                stage.classList.add('tsxv5-has-image');
                setButtonsEnabled(true);
                updateInfo();
                render(false);
                buildThumbnails();
                showToast('✅ Image loaded: ' + fileName);
            };
            img.onerror = function () { showToast('⚠️ Could not read this image', true); };
            img.src = e.target.result;
        };
        reader.onerror = function () { showToast('⚠️ File read error', true); };
        reader.readAsDataURL(file);
    }

    function updateInfo() {
        $('tsxv5-ailab-infoName').textContent = fileName || 'Untitled';
        $('tsxv5-ailab-infoDims').textContent = sourceImage ? (sourceImage.width + ' × ' + sourceImage.height) : '—';
        $('tsxv5-ailab-infoSize').textContent = formatBytes(fileSize);
    }

    function formatBytes(bytes) {
        if (!bytes || bytes === 0) return '—';
        const k = 1024;
        const sizes = ['B', 'KB', 'MB', 'GB'];
        const i = Math.floor(Math.log(bytes) / Math.log(k));
        return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + ' ' + sizes[i];
    }

    function setButtonsEnabled(on) {
        const ids = ['tsxv5-ailab-resetBtn', 'tsxv5-ailab-downloadTopBtn', 'tsxv5-ailab-compareBtn', 'tsxv5-ailab-downloadBtn', 'tsxv5-ailab-exportBtn'];
        ids.forEach(function (id) { $(id).disabled = !on; });
    }

    function resetAll(silent) {
        Object.assign(state, DEFAULTS);
        rotation = 0; flipH = false; flipV = false;
        SLIDERS.forEach(function (def) {
            const ref = sliderRefs[def.key];
            ref.input.value = DEFAULTS[def.key];
            ref.valEl.textContent = DEFAULTS[def.key] + ref.suffix;
        });
        setActivePreset('Original');
        if (sourceImage) render(false);
        if (!silent) showToast('↺ All changes reset');
    }
    $('tsxv5-ailab-resetBtn').addEventListener('click', function () { resetAll(false); });

    $('tsxv5-ailab-rotLeftBtn').addEventListener('click', function () { if (!sourceImage) return; rotation = (rotation + 270) % 360; requestRender(); });
    $('tsxv5-ailab-rotRightBtn').addEventListener('click', function () { if (!sourceImage) return; rotation = (rotation + 90) % 360; requestRender(); });
    $('tsxv5-ailab-flipHBtn').addEventListener('click', function () { if (!sourceImage) return; flipH = !flipH; requestRender(); });
    $('tsxv5-ailab-flipVBtn').addEventListener('click', function () { if (!sourceImage) return; flipV = !flipV; requestRender(); });

    const compareBtn = $('tsxv5-ailab-compareBtn');
    function showOrig(e) { if (e) e.preventDefault(); if (sourceImage) render(true); }
    function showEdit() { if (sourceImage) requestRender(); }
    compareBtn.addEventListener('mousedown', showOrig);
    compareBtn.addEventListener('mouseup', showEdit);
    compareBtn.addEventListener('mouseleave', showEdit);
    compareBtn.addEventListener('touchstart', showOrig, { passive: false });
    compareBtn.addEventListener('touchend', showEdit);

    const qualityRange = $('tsxv5-ailab-qualityRange');
    qualityRange.addEventListener('input', function () {
        $('tsxv5-ailab-qualityVal').textContent = qualityRange.value + '%';
    });

    function exportImage() {
        if (!sourceImage) { showToast('⚠️ Load an image first', true); return; }
        const format = $('tsxv5-ailab-formatSelect').value;
        const quality = parseInt(qualityRange.value, 10) / 100;
        const mime = (format === 'png') ? 'image/png' : ('image/' + format);
        let target = canvas;
        if (format === 'jpeg') {
            const tc = document.createElement('canvas');
            tc.width = canvas.width; tc.height = canvas.height;
            const tctx = tc.getContext('2d');
            tctx.fillStyle = '#ffffff'; tctx.fillRect(0, 0, tc.width, tc.height);
            tctx.drawImage(canvas, 0, 0);
            target = tc;
        }
        try {
            target.toBlob(function (blob) {
                if (!blob) { showToast('⚠️ Export failed in this browser', true); return; }
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                const base = (fileName || 'image').replace(/\.[^.]+$/, '');
                a.href = url;
                a.download = base + '_ToolsX_edited.' + format;
                document.body.appendChild(a);
                a.click();
                a.remove();
                setTimeout(function () { URL.revokeObjectURL(url); }, 1500);
                showToast('💾 Saved as ' + format.toUpperCase() + ' • ' + formatBytes(blob.size));
            }, mime, quality);
        } catch (err) {
            showToast('⚠️ This format is not supported by your browser', true);
        }
    }

    $('tsxv5-ailab-downloadBtn').addEventListener('click', exportImage);
    $('tsxv5-ailab-exportBtn').addEventListener('click', exportImage);
    $('tsxv5-ailab-downloadTopBtn').addEventListener('click', exportImage);

    let toastTimer = null;
    function showToast(msg, isWarn) {
        toast.textContent = msg;
        toast.classList.toggle('tsxv5-warn', !!isWarn);
        toast.classList.add('tsxv5-show');
        if (toastTimer) clearTimeout(toastTimer);
        toastTimer = setTimeout(function () { toast.classList.remove('tsxv5-show'); }, 2800);
    }

    if (!FILTER_OK) {
        showToast('⚠️ Your browser has limited filter support', true);
    }
})();
</script>
